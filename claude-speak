#!/usr/bin/env bash
# claude-speak — speak a Claude Code response aloud with Kokoro neural TTS.
#
# Reads text on stdin, strips it down to something worth listening to (code
# blocks, tables and paths are unspeakable), then synthesizes and plays it.
# Synthesis runs a chunk ahead of playback so speech starts in about a second
# instead of after the whole response is rendered.
#
# Utterances QUEUE rather than supersede each other. A single turn arrives in
# several pieces — the sentence before a tool call, the one after it, the
# closing summary — and each has to wait its turn instead of cutting off the one
# before. Interruption is explicit: --stop kills in-flight playback and drops
# whatever is queued behind it, which is how the dictate hotkey and a new prompt
# barge in mid-sentence.
#
# Config: env vars, or set them in ~/.config/claude-dictate/config (shared with
# claude-dictate; plain shell, sourced if present):
#
#   SPEAK_ENABLED       0 to mute entirely            (default: 1)
#   SPEAK_ENGINE        sherpa-onnx-offline-tts path  (default: 99dps cache)
#   SPEAK_MODEL_DIR     kokoro model dir              (default: 99dps cache)
#   SPEAK_SID           voice index, 0-10             (default: 1, af_bella)
#   SPEAK_LENGTH_SCALE  larger is slower              (default: 1.1)
#   SPEAK_MAX_CHARS     cap before truncating         (default: 1200)
#   SPEAK_SINK          output sink to play through   (default: the mic's card)
set -u

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/claude-dictate"
PGID_FILE="$RUN_DIR/speak.pgid"
SPOOL="$RUN_DIR/spool"
LOCKFILE="$RUN_DIR/speak.lock"

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/claude-dictate/config"
if [[ -f "$CONFIG_FILE" ]]; then
    bash -n "$CONFIG_FILE" 2>/dev/null && { set +u; . "$CONFIG_FILE"; set -u; }
fi

# Default to the assets 99dps already downloaded — ~120MB we don't need twice.
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/99dps/tts"
ENGINE="${SPEAK_ENGINE:-$CACHE/engine/sherpa-onnx-v1.13.2-linux-x64-shared/bin/sherpa-onnx-offline-tts}"
MODEL_DIR="${SPEAK_MODEL_DIR:-$CACHE/model/kokoro-int8-en-v0_19}"
SID="${SPEAK_SID:-1}"
LENGTH_SCALE="${SPEAK_LENGTH_SCALE:-0.85}"
MAX_CHARS="${SPEAK_MAX_CHARS:-1200}"
ENABLED="${SPEAK_ENABLED:-1}"

# --- output device ----------------------------------------------------------

# Reply through the headset you're talking into, not whatever the system
# default sink happens to be. The capture and playback nodes of one card share
# a name stem — alsa_input.<stem>.<profile> / alsa_output.<stem>.<profile> — so
# the mic the recorder is pinned to names the sink to answer through.
# claude-mic publishes the source it resolved, and that file wins over anything
# parsed out of the recorder command. It has to: once the recorder stops naming
# a device and asks claude-mic for one instead, the command string holds no
# --target to read, and a headset that moves between its dongle and its cable
# changes which card is live without any config changing at all. The parse
# stays for a recorder that still pins a name by hand.
recorder_target() {
    local published="${XDG_RUNTIME_DIR:-/tmp}/claude-dictate/mic"
    if [[ -s "$published" ]]; then
        printf '%s' "$(cat "$published")"
        return 0
    fi
    local prev="" w
    for w in ${DICTATE_RECORDER:-}; do
        [[ "$prev" == "--target" ]] && { printf '%s' "$w"; return 0; }
        [[ "$w" == --target=* ]] && { printf '%s' "${w#--target=}"; return 0; }
        prev="$w"
    done
}

sink_for_source() {
    local src="$1" stem name
    [[ "$src" == alsa_input.* ]] || return 0
    stem="${src#alsa_input.}"
    stem="${stem%.*}"
    while read -r _ name _; do
        [[ "$name" == "alsa_output.$stem."* ]] && { printf '%s' "$name"; return 0; }
    done < <(pactl list short sinks 2>/dev/null)
}

SINK="${SPEAK_SINK:-}"
[[ -n "$SINK" ]] || SINK=$(sink_for_source "$(recorder_target)")

play() { # blocks until the clip finishes — that's what serializes chunks
    # A pinned sink is a preference, not a requirement: if the headset is off
    # its node is gone, and falling through to the default device is better
    # than silence.
    if [[ -n "$SINK" ]]; then
        command -v pw-play >/dev/null &&
            pw-play --target "$SINK" "$1" 2>/dev/null && return
        command -v paplay >/dev/null &&
            paplay --device="$SINK" "$1" 2>/dev/null && return
    fi
    if command -v paplay >/dev/null; then paplay "$1" 2>/dev/null
    elif command -v aplay >/dev/null; then aplay -q "$1" 2>/dev/null
    else ffplay -nodisp -autoexit -loglevel quiet "$1" 2>/dev/null
    fi
}

# Play an arbitrary wav through the resolved sink — claude-listen's state tones
# ride this so device selection lives in exactly one place.
if [[ "${1:-}" == "--play" ]]; then
    [[ -f "${2:-}" ]] && play "$2"
    exit 0
fi

# --- stop -------------------------------------------------------------------

# Kill the whole detached process group, so an in-flight sherpa or player dies
# with it rather than finishing the sentence after we've been told to shut up.
#
# The queue is dropped BEFORE the kill: everything spooled behind the sentence
# being cut off belongs to the same superseded turn, and a drainer waiting for
# the lock would otherwise pick it up and carry on talking.
stop_playback() {
    rm -f "$SPOOL"/*.txt 2>/dev/null
    local pgid
    pgid=$(cat "$PGID_FILE" 2>/dev/null) || return 0
    rm -f "$PGID_FILE"
    [[ "$pgid" =~ ^[0-9]+$ ]] || return 0
    kill -TERM -- "-$pgid" 2>/dev/null
    return 0
}

if [[ "${1:-}" == "--stop" ]]; then
    stop_playback
    exit 0
fi

# --- enqueue ----------------------------------------------------------------

# The hook must return immediately — it has a timeout, and playback can run for
# a minute — so the first pass only slurps stdin into the spool and re-execs
# itself detached to drain it. Being a session leader is also what makes the
# group kill in stop_playback work.
#
# The name is a nanosecond stamp so the spool sorts into arrival order, which is
# the order a turn's sentences have to be spoken in.
if [[ "${1:-}" != "--drain" ]]; then
    mkdir -p "$SPOOL"
    tmp="$RUN_DIR/utt.$$.tmp"
    cat > "$tmp"
    [[ -s "$tmp" ]] || { rm -f "$tmp"; exit 0; }
    [[ "$ENABLED" == "1" ]] || { rm -f "$tmp"; exit 0; }
    # move into the spool only once it's complete, so a drainer can never pick
    # up a half-written utterance
    mv "$tmp" "$SPOOL/$(date +%s%N).$$.txt"
    setsid --fork "$0" --drain >/dev/null 2>&1 </dev/null
    exit 0
fi

# --- detached from here -----------------------------------------------------

# No engine or no model means nothing will EVER consume the spool, so the
# no-op contract has to include discarding what was just spooled — otherwise
# every hook firing accumulates in tmpfs, and the whole stale backlog gets
# spoken in one burst the moment the engine appears.
command -v "$ENGINE" >/dev/null || { rm -f "$SPOOL"/*.txt 2>/dev/null; exit 0; }
[[ -f "$MODEL_DIR/model.int8.onnx" ]] || { rm -f "$SPOOL"/*.txt 2>/dev/null; exit 0; }

# One utterance is spoken at a time. A drainer that finds the lock held bows
# out immediately — no bash parked on flock for the length of a read-aloud.
# That's safe because the HOLDER closes the handoff race: after its last look
# finds the spool empty it releases the lock and looks once more, so an
# utterance spooled in that window is picked up by the holder itself (or by
# whichever new drainer beat it to the re-acquire).
exec 9>"$LOCKFILE"
flock -n 9 || exit 0

WORK=$(mktemp -d "$RUN_DIR/speak.XXXXXX") || exit 0
MYPGID=$(ps -o pgid= -p $$ | tr -d ' ')
# Remove the pgid file only if it's still ours — once the lock is released a
# newer drainer may have claimed it, and --stop needs THAT one's pgid.
cleanup() {
    rm -f "$WORK"/*.wav 2>/dev/null; rmdir "$WORK" 2>/dev/null
    [[ "$(cat "$PGID_FILE" 2>/dev/null)" == "$MYPGID" ]] && rm -f "$PGID_FILE"
    return 0
}
trap cleanup EXIT

printf '%s\n' "$MYPGID" > "$PGID_FILE"

# Drain in arrival order until the spool is empty. --stop empties the spool
# before killing us, so an interrupted turn stops for good rather than resuming
# with its next sentence.
drain() {
    local name
    while :; do
        name=$(ls -1 "$SPOOL" 2>/dev/null | sort | head -1)
        [[ -n "$name" ]] || return 0
        speak_file "$SPOOL/$name"
        rm -f "$SPOOL/$name"
    done
}

synth() { # synth(text, out.wav)
    "$ENGINE" \
        --kokoro-model="$MODEL_DIR/model.int8.onnx" \
        --kokoro-voices="$MODEL_DIR/voices.bin" \
        --kokoro-tokens="$MODEL_DIR/tokens.txt" \
        --kokoro-data-dir="$MODEL_DIR/espeak-ng-data" \
        --kokoro-length-scale="$LENGTH_SCALE" \
        --sid="$SID" \
        --num-threads=4 \
        --output-filename="$2" \
        "$1" >/dev/null 2>&1
}

# speak_file(path) — render one utterance and play it through.
speak_file() {
    local UTT="$1" i next synth_pid
    local -a CHUNKS

    # Reduce markdown to speech and split it into sentence-sized chunks, one per
    # line. Chunking is what lets synthesis run ahead of playback.
    mapfile -t CHUNKS < <(MAX_CHARS="$MAX_CHARS" python3 - "$UTT" <<'PY'
import os, re, sys

text = open(sys.argv[1], encoding="utf-8", errors="replace").read()

# Unspeakable structure goes first, before anything unwraps it into prose.
text = re.sub(r"```.*?```", " ", text, flags=re.S)
text = re.sub(r"~~~.*?~~~", " ", text, flags=re.S)
text = "\n".join(l for l in text.split("\n") if not l.lstrip().startswith("|"))

text = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", text)   # [text](url) -> text
text = re.sub(r"https?://\S+", "link", text)
text = re.sub(r"`([^`]*)`", r"\1", text)               # keep inline code content

# A path read aloud is a wall of "slash". Its basename carries the meaning.
text = re.sub(r"(?:/[\w.\-]+){2,}/?", lambda m: m.group(0).rstrip("/").split("/")[-1], text)

text = re.sub(r"^\s{0,3}#{1,6}\s*", "", text, flags=re.M)        # headers
text = re.sub(r"^\s*(?:[-*+]|\d+\.)\s+", "", text, flags=re.M)   # list markers
text = re.sub(r"\*\*([^*]+)\*\*", r"\1", text)
text = re.sub(r"(?<!\w)[*_]([^*_\n]+)[*_](?!\w)", r"\1", text)

text = text.translate(str.maketrans({
    "‘": "'", "’": "'", "“": '"', "”": '"',
    "—": ", ", "–": ", ", "…": ".",
}))
text = re.sub(r"[^\x00-\x7f]", " ", text)   # emoji, box drawing, arrows

# Each line becomes its own sentence so bullet lists don't run together.
lines = []
for line in text.split("\n"):
    line = re.sub(r"\s+", " ", line).strip()
    if not line:
        continue
    if line[-1] not in ".!?:,;":
        line += "."
    lines.append(line)
text = " ".join(lines)
text = re.sub(r"\s+", " ", text).strip()

cap = int(os.environ.get("MAX_CHARS", "1200"))
if len(text) > cap:
    cut = text.rfind(" ", 0, cap)
    text = text[: cut if cut > 0 else cap] + ". Response truncated."

if not re.search(r"[A-Za-z]", text):
    sys.exit(0)

# Greedily pack sentences into chunks. The opening chunk is deliberately short:
# nothing is audible until it finishes rendering, so it sets time-to-first-word.
# Later chunks render while earlier ones play, so they can be longer — which
# keeps prosody natural rather than clipped sentence by sentence.
FIRST, REST = 90, 240
sentences = re.findall(r"[^.!?]*[.!?]+|\S[^.!?]*$", text)
chunk, out = "", []
for s in sentences:
    s = s.strip()
    if not s:
        continue
    limit = FIRST if not out else REST
    if chunk and len(chunk) + len(s) + 1 > limit:
        out.append(chunk)
        chunk = s
    else:
        chunk = f"{chunk} {s}".strip()
if chunk:
    out.append(chunk)

for c in out:
    print(c)
PY
    )

    (( ${#CHUNKS[@]} )) || return 0

    # Synthesize chunk 0, then keep one chunk in flight ahead of the speaker:
    # while chunk i plays, chunk i+1 renders. Time-to-first-word is one chunk.
    synth "${CHUNKS[0]}" "$WORK/0.wav" || return 0
    for (( i = 0; i < ${#CHUNKS[@]}; i++ )); do
        next=$(( i + 1 ))
        if (( next < ${#CHUNKS[@]} )); then
            synth "${CHUNKS[$next]}" "$WORK/$next.wav" &
            synth_pid=$!
        else
            synth_pid=""
        fi

        [[ -s "$WORK/$i.wav" ]] && play "$WORK/$i.wav"
        rm -f "$WORK/$i.wav"

        [[ -n "$synth_pid" ]] && wait "$synth_pid"
    done
    return 0
}

# Drain, then close the handoff window: release the lock FIRST, then look at
# the spool once more. An utterance that arrived during our last drain pass saw
# the lock held and its drainer bowed out — with the lock now free, either we
# re-acquire and drain it, or a newer drainer already has.
while :; do
    drain
    flock -u 9
    [[ -n "$(ls -A "$SPOOL" 2>/dev/null)" ]] || break
    flock -n 9 || break
done
