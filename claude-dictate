#!/usr/bin/env bash
# claude-dictate — toggle voice dictation into a tmux session.
#
# Press once to start recording the mic. Press again to stop, transcribe
# with whisper.cpp, and inject the text into the tmux session via send-keys
# — no window focus required, so it works while a game owns your keyboard.
#
# Config: env vars, or set them in ~/.config/claude-dictate/config
# (plain shell, sourced if present):
#
#   DICTATE_WHISPER   whisper-cli binary          (default: whisper-cli on PATH)
#   DICTATE_MODEL     path to a ggml model        (required)
#   DICTATE_TARGET    tmux session to inject to   (default: claude)
#   DICTATE_RECORDER  record command; gets the output .wav appended, must
#                     write 16kHz mono s16 and stop cleanly on SIGTERM
#                     (default: pw-record --rate 16000 --channels 1 --format s16)
#   DICTATE_SUBMIT_DELAY  pause between the text and the Enter that submits
#                     it, in seconds (default: 0.5) — see stop_and_send
set -u

notify() { # notify(urgency, timeout_ms, body)
    command -v notify-send >/dev/null && notify-send -u "$1" -t "$2" "claude-dictate" "$3"
    return 0
}

die() {
    notify critical 5000 "$1"
    echo "claude-dictate: $1" >&2
    exit 1
}

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/claude-dictate/config"
if [[ -f "$CONFIG_FILE" ]]; then
    bash -n "$CONFIG_FILE" 2>/dev/null || die "syntax error in $CONFIG_FILE"
    set +u
    . "$CONFIG_FILE"
    set -u
fi

WHISPER="${DICTATE_WHISPER:-whisper-cli}"
MODEL="${DICTATE_MODEL:-}"
TARGET="${DICTATE_TARGET:-claude}"
RECORDER="${DICTATE_RECORDER:-pw-record --rate 16000 --channels 1 --format s16}"
SUBMIT_DELAY="${DICTATE_SUBMIT_DELAY:-0.5}"

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/claude-dictate"
PIDFILE="$RUN_DIR/rec.pid"
WAV="$RUN_DIR/rec.wav"

# Below ~0.5s of 16kHz mono s16 audio there's nothing worth transcribing.
MIN_WAV_BYTES=16000

# Collapse to one line and strip whisper's non-speech markers — a belt for
# --suppress-nst's suspenders; markers like [BLANK_AUDIO]/(coughing) still
# slip through it occasionally.
clean_text() {
    tr '\n' ' ' | sed -E 's/\[[A-Z_ ]+\]//g; s/\([a-z ]+\)//g; s/[[:space:]]+/ /g; s/^ //; s/ $//'
}

# Whisper hallucinates these on quiet audio that slips past the size gate.
is_hallucination() {
    local t="${1,,}"
    while [[ "$t" == *[.!?] ]]; do t="${t%?}"; done
    case "$t" in
        ""|you|thank\ you|thanks\ for\ watching|bye) return 0 ;;
    esac
    return 1
}

start_recording() {
    # Barge-in: a reply still being read aloud would end up in the recording,
    # so cut it off before opening the mic.
    command -v claude-speak >/dev/null && claude-speak --stop
    rm -f "$WAV"
    $RECORDER "$WAV" &
    local pid=$!
    sleep 0.1
    kill -0 "$pid" 2>/dev/null || die "recorder failed to start: $RECORDER"
    # noclobber write arbitrates hotkey double-fires: the loser kills its
    # recorder and bows out
    if ! (set -o noclobber; echo "$pid" > "$PIDFILE") 2>/dev/null; then
        kill "$pid" 2>/dev/null
        exit 0
    fi
    notify low 60000 "recording... press again to send"
}

stop_and_send() {
    local claimed="$1" pid
    pid=$(cat "$claimed")
    rm -f "$claimed"

    # only signal if the PID still belongs to our recorder — a stale pidfile
    # must not kill whatever process recycled the PID (cmdline, not comm:
    # interpreter-script recorders show up as e.g. "bash")
    local rec_name
    rec_name=$(basename "${RECORDER%% *}")
    if tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -qF "$rec_name"; then
        kill "$pid" 2>/dev/null
        # wait for the recorder to flush and close the wav (not our child, so no `wait`)
        timeout 2 tail --pid="$pid" -f /dev/null
    fi

    if (( $(stat -c%s "$WAV" 2>/dev/null || echo 0) < MIN_WAV_BYTES )); then
        notify critical 3000 "heard nothing"
        return 0
    fi

    notify low 2000 "transcribing..."
    local raw text
    raw=$("$WHISPER" -m "$MODEL" -f "$WAV" --no-prints --no-timestamps --suppress-nst \
          2>"$RUN_DIR/whisper.log") \
        || die "transcription failed — see $RUN_DIR/whisper.log"
    text=$(clean_text <<<"$raw")

    if is_hallucination "$text"; then
        notify critical 3000 "heard nothing"
        return 0
    fi

    inject "$text"
    notify normal 4000 "➜ $text"
}

# inject TEXT — type TEXT into the target session and submit it. Also reachable
# as `claude-dictate --send TEXT` so claude-listen can put a voice-assembled
# transmission through the same path rather than reimplementing these quirks.
inject() {
    local text="$1"
    tmux has-session -t "=$TARGET" 2>/dev/null \
        || die "no tmux session '$TARGET' — start one with: tmux new -s $TARGET claude"

    # tmux argv parsing eats a trailing unescaped ';' — escape it
    [[ "$text" == *\; ]] && text="${text%;}\\;"
    tmux send-keys -t "=$TARGET:" -l -- "$text" || die "tmux send-keys failed"

    # The Enter must NOT ride along in the same tmux command. Chained, both
    # land in one read and the TUI swallows the newline into the text it's
    # still ingesting — the transcript sits in the prompt box unsent. Measured
    # against a live session: chained never submits, a ~0.4s gap always does.
    sleep "$SUBMIT_DELAY"
    tmux send-keys -t "=$TARGET:" Enter || die "tmux send-keys failed"
}

main() {
    if [[ "${1:-}" == "--send" ]]; then
        shift
        [[ -n "${1:-}" ]] || exit 0
        inject "$*"
        exit 0
    fi

    command -v "$WHISPER" >/dev/null || die "whisper-cli not found — set DICTATE_WHISPER in $CONFIG_FILE"
    [[ -f "$MODEL" ]] || die "model not found — set DICTATE_MODEL in $CONFIG_FILE"
    mkdir -p "$RUN_DIR"

    # mv atomically claims the pidfile: exactly one of two racing stop
    # presses wins; the loser (or a plain start press) falls through
    local claimed="$PIDFILE.claimed.$$"
    if mv "$PIDFILE" "$claimed" 2>/dev/null; then
        stop_and_send "$claimed"
    else
        start_recording
    fi
}

# Run main unless we're being sourced (e.g. by the tests).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
