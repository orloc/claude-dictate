#!/usr/bin/env bash
# claude-dictate — toggle voice dictation into a tmux session.
#
# Press once to start recording the mic. Press again to stop, transcribe
# with whisper.cpp, and inject the text into the tmux session via send-keys
# — no window focus required, so it works while a game owns your keyboard.
#
# Config: env vars, or set them in ~/.config/claude-dictate/config
# (plain shell, sourced if present):
#
#   DICTATE_WHISPER   whisper-cli binary          (default: whisper-cli on PATH)
#   DICTATE_MODEL     path to a ggml model        (required)
#   DICTATE_TARGET    tmux session to inject to   (default: claude)
#   DICTATE_RECORDER  record command; gets the output .wav appended, must
#                     write 16kHz mono s16 and stop cleanly on SIGTERM
#                     (default: pw-record --rate 16000 --channels 1 --format s16)
set -u

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/claude-dictate/config"
[[ -f "$CONFIG_FILE" ]] && . "$CONFIG_FILE"

WHISPER="${DICTATE_WHISPER:-whisper-cli}"
MODEL="${DICTATE_MODEL:-}"
TARGET="${DICTATE_TARGET:-claude}"
RECORDER="${DICTATE_RECORDER:-pw-record --rate 16000 --channels 1 --format s16}"

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/claude-dictate"
PIDFILE="$RUN_DIR/rec.pid"
WAV="$RUN_DIR/rec.wav"

# Below ~0.5s of 16kHz mono s16 audio there's nothing worth transcribing.
MIN_WAV_BYTES=16000

notify() { # notify(urgency, timeout_ms, body)
    command -v notify-send >/dev/null && notify-send -u "$1" -t "$2" "claude-dictate" "$3"
}

die() {
    notify critical 5000 "$1"
    echo "claude-dictate: $1" >&2
    exit 1
}

clean_text() {
    tr -s '[:space:]' ' ' | sed -E 's/^ //; s/ $//'
}

# Whisper hallucinates these on quiet audio that slips past the size gate.
is_hallucination() {
    local t="${1,,}"
    t="${t%.}"
    case "$t" in
        ""|you|thank\ you|thanks\ for\ watching!|bye) return 0 ;;
    esac
    return 1
}

start_recording() {
    rm -f "$WAV"
    $RECORDER "$WAV" &
    echo $! > "$PIDFILE"
    notify low 60000 "recording... press again to send"
}

stop_and_send() {
    local pid
    pid=$(cat "$PIDFILE")
    rm -f "$PIDFILE"
    kill "$pid" 2>/dev/null
    # wait for the recorder to flush and close the wav (not our child, so no `wait`)
    timeout 2 tail --pid="$pid" -f /dev/null

    if (( $(stat -c%s "$WAV" 2>/dev/null || echo 0) < MIN_WAV_BYTES )); then
        notify critical 3000 "heard nothing"
        return 0
    fi

    notify low 2000 "transcribing..."
    local raw text
    raw=$("$WHISPER" -m "$MODEL" -f "$WAV" --no-prints --no-timestamps --suppress-nst \
          2>"$RUN_DIR/whisper.log") \
        || die "transcription failed — see $RUN_DIR/whisper.log"
    text=$(clean_text <<<"$raw")

    if is_hallucination "$text"; then
        notify critical 3000 "heard nothing"
        return 0
    fi

    tmux has-session -t "$TARGET" 2>/dev/null \
        || die "no tmux session '$TARGET' — start one with: tmux new -s $TARGET claude"

    tmux send-keys -t "$TARGET" -l "$text" \; send-keys -t "$TARGET" Enter
    notify normal 4000 "➜ $text"
}

main() {
    command -v "$WHISPER" >/dev/null || die "whisper-cli not found — set DICTATE_WHISPER in $CONFIG_FILE"
    [[ -f "$MODEL" ]] || die "model not found — set DICTATE_MODEL in $CONFIG_FILE"
    mkdir -p "$RUN_DIR"

    if [[ -f "$PIDFILE" ]]; then
        stop_and_send
    else
        start_recording
    fi
}

# Run main unless we're being sourced (e.g. by the tests).
[[ "${BASH_SOURCE[0]}" == "$0" ]] && main
